# Server
PORT=3300
HOST=0.0.0.0
NODE_ENV=development

# Database
DB_PATH=./data/uptime-detective.db

# Auth
JWT_SECRET=change-me-to-a-random-string
SESSION_EXPIRY=7d

# Monitoring
ALLOW_PRIVATE_IPS=true    # Set to true to monitor private/internal IPs (e.g. 192.168.x, 10.x)

# Optional: SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Telegram bot (can also be configured in Settings -> Telegram Bot)
# Create a bot with @BotFather and paste its token here.
# TELEGRAM_BOT_TOKEN=
# Set to false to keep a token configured but disable chat control (default: true).
# Notifications keep using the token even when chat control is disabled.
# TELEGRAM_BOT_ENABLED=true
# Comma-separated Telegram user IDs allowed automatically when the server starts
# TELEGRAM_ADMIN_USER_IDS=
# Telegram Bot API base URL (default: https://api.telegram.org)
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# Public HTTPS URL of this instance for the Telegram Mini App
# TELEGRAM_WEBAPP_URL=
# Max accepted age of Mini App initData in seconds (default: 86400 = 24h)
# TELEGRAM_WEBAPP_AUTH_MAX_AGE=86400
# Public base URL of this instance, used for monitor links in notifications
# APP_URL=
